{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:allow-default-urls",
    "opener:allow-open-url",
    "process:default",
    "sql:default",
    "sql:allow-execute",
    "updater:default"
  ]
}
